@page "/Settings"

@using Domain.Pocos

@inherits SettingsPageBase

<MudCardContent>
   <MudFocusTrap Disabled="false"
                 DefaultFocus=DefaultFocus.FirstChild>
      <MudText Typo="Typo.h5">MQTT</MudText>
      <MudPaper Class="pa-6" Height="450px" Width="1200px" Elevation="2">
         <MudSwitch T="bool"
                    Value="@MqttBrokerSettings.UseInternalMqttBroker"
                    ValueChanged="UseInternalMqttBrokerChanged"
                    Label="Start internal MQTT Broker"
                    Color="Color.Primary" />
         <br />
         <MudStack Row=false>
            <MudStack Row=true>
               <MudTextField ReadOnly="false"
                             Label="MQTT Broker IPv4 Address"
                             @bind-Value="MqttBrokerSettings.Ip"
                             Variant="@Variant.Text" Clearable>
               </MudTextField>
               <MudTextField ReadOnly="false"
                             Label="MQTT Broker Port"
                             Format="D"
                             HelperText="Example: 1883"
                             @bind-Value="MqttBrokerSettings.Port"
                             Variant="@Variant.Text" Clearable>
               </MudTextField>
            </MudStack>
            <MudStack Row=true>
               <div style="width: 50%">
                  <MudTextField ReadOnly="false"
                                Label="MQTT Broker Username"
                                autocomplete="off"
                                @bind-Value="MqttBrokerSettings.User"
                                Variant="@Variant.Text" Clearable>
                  </MudTextField>
               </div>
               <div style="width: 50%">
                  <MudTextField ReadOnly="false"
                                Label="MQTT Broker Password"
                                InputType="InputType.Password"
                                autocomplete="new-password"
                                @bind-Value="MqttBrokerSettings.Password"
                                Variant="@Variant.Text">
                  </MudTextField>
               </div>
            </MudStack>
            <br />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width:120px" OnClick="TestMqttConnectionAsync">Test Connection</MudButton>
            <br />
         </MudStack>
         <div style="width: 50%">
            <MudTextField Label="Namespace Name"
                          @bind-Value="MqttNamespaceName"
                          Variant="@Variant.Text" Clearable="false">
            </MudTextField>
         </div>
      </MudPaper>
      <br />
      <br />
      <MudDivider DividerType="DividerType.FullWidth" />
      <br />
      <br />
      <MudText Typo="Typo.h5">Philips HUE Bridge</MudText>
      <MudPaper Height="250px" Width="1200px" Elevation="1">
         <MudStack Row=true>
            <MudStack>
               <MudPaper Elevation="0" Class="pa-6" Width="600px" Height="250px">
                  <MudTextField Mask="@RegexMask.IPv4(false)"
                                Label="Philips Hue Bridge IP Address"
                                HelperText="Example: 192.168.178.34"
                                @bind-Value="HueBridgeIp"
                                Variant="@Variant.Text" Clearable>
                  </MudTextField>
                  <br />
                  <MudAlert Severity="Severity.Info">
                     You can get the ip address of your Hue bridge from your Router or the Philips Hue App on your phone, see settings.
                  </MudAlert>
               </MudPaper>
            </MudStack>
            <MudStack Row=true>
               <MudStack>
                  <MudPaper Elevation="0" Class="pa-6" Width="600px" Height="250px">
                     <MudTextField Label="Philips Hue Bridge Application Key"
                                   HelperText="Example: RnQXJ6v4mC5SuLLtBrflBzSJc43KvBXYp-aY6uaG"
                                   @bind-Value="HueBridgeAppKey"
                                   Variant="@Variant.Text" Clearable>
                     </MudTextField>
                     <br />
                     <MudAlert Severity="Severity.Info">
                        Press the Link-Button on the HUE-Bridge and then this Button to receive the Key:
                        <MudIconButton Icon="@Icons.Material.Outlined.AppRegistration"
                                       Color="Color.Success"
                                       OnClick="RegisterAtPhilipsHueBridgeAsync">
                        </MudIconButton>
                     </MudAlert>
                  </MudPaper>
               </MudStack>
            </MudStack>
         </MudStack>
      </MudPaper>
      <br />
      <br />
      <MudText Typo="Typo.h5">Mail Receiver</MudText>
      <div style="width:64px; height:64px">
         <MudIconButton Icon="@Icons.Material.Outlined.Add"
                        Color="Color.Success"
                        OnClick="AddMailReceiver">
         </MudIconButton>
      </div>
      <br />
      @foreach (var mailReceiverConfig in MailReceiverConfigs)
      {
         <MudStack Row="true">
            <IotZoo.Components.MailSettingsComponent MailReceiverConfig="@mailReceiverConfig">
            </IotZoo.Components.MailSettingsComponent>
            <div style="width:64px; height:64px">
               <MudIconButton Icon="@Icons.Material.Outlined.Remove"
                              Color="Color.Error"
                              OnClick="@(()=>RemoveEmailConfig(mailReceiverConfig))">
               </MudIconButton>
            </div>
         </MudStack>
         <br />
      }
      <br />
      <br />
      <MudDivider DividerType="DividerType.FullWidth" />
      <br />
      <br />
      <MudText Typo="Typo.h5">Date and Time format</MudText>
      <MudPaper Class="pa-6" Width="1200px" Height="250px">
         <MudText>
            Local time zone: @TimeZoneInfo.Local.DisplayName
         </MudText>
         <MudText>
            Daylight changes:
         </MudText>
         <MudStack Row=true>
            <MudText>
               Summertime Start: @SummertimeStart
            </MudText>
            <MudText>
               Wintertime Start: @WintertimeStart
            </MudText>
         </MudStack>
         <br />
         <MudStack Row=true>
            <div style="width: 350px;">
               <MudSelect T="string"
                          Label="Date and Time format"
                          @bind-Value="DataTransferService.DateTimeFormat"
                          AnchorOrigin="Origin.BottomCenter">
                  <MudSelectItem Value="@("dd.MM.yyyy HH:mm:ss")" />
                  <MudSelectItem Value="@("yyyy-MM-dd HH:mm:ss")" />
               </MudSelect>
            </div>
         </MudStack>
      </MudPaper>
      <br />
      <br />
      <MudDivider DividerType="DividerType.FullWidth" />
      <br />
      <br />
      <MudText Typo="Typo.h5">User Interface</MudText>
      <MudPaper Class="pa-6" Height="200px" Width="600px" Elevation="1">
         <MudSwitch Value="@DataTransferService.IsDarkMode"
                    ValueChanged="DarkModeChanged"
                    Color="Color.Primary"
                    T="bool"
                    Label="Dark Mode" />
         <br />
         <MudNumericField T="int"
                          Label="MQTT Explorer: max. received topics"
                          HelperText="Default: 75"
                          Min="1"
                          @bind-Value="DataTransferService.MqttExplorerMaxReceivedTopics"
                          Variant="@Variant.Text" />
      </MudPaper>
   </MudFocusTrap>
       <br />
       <MudText Typo="Typo.h5">Security</MudText>
       <MudPaper Class="pa-6" Height="200px" Width="600px" Elevation="1">
          <MudTextField T="string"
                        Label="Unlock code"
                        HelperText="@(AppLock.IsLockEnabled ? "An unlock code is set. Enter a new code to change it." : "No unlock code set: the app runs without login.")"
                        InputType="InputType.Password"
                        autocomplete="new-password"
                        @bind-Value="UnlockCodeInput"
                        Variant="@Variant.Text" />
          <br />
          <MudButton Variant="Variant.Outlined"
                     Color="Color.Error"
                     Disabled="@(!AppLock.IsLockEnabled)"
                     OnClick="RemoveUnlockCode">Remove unlock code</MudButton>
       </MudPaper>
       <br />
   <br />
   <div style="position: relative; top: 13px;">
      <MudStack Row="true">
         <MudButton Variant="Variant.Filled"
                    Style="width:100px; height: 40px;"
                    Color="Color.Success"
                    OnClick="Save">Save</MudButton>
         <MudTooltip Text="Export to Clipboard">
            <MudButton Variant="Variant.Outlined"
                       Style="width:120px; height: 40px;"
                       Color="Color.Primary"
                       OnClick="ExportSettingsToClipboard">Export</MudButton>
         </MudTooltip>
         <MudTooltip Text="Import from Clipboard">
            <MudButton Variant="Variant.Outlined"
                       Style="width:120px; height: 40px;"
                       Color="Color.Primary"
                       OnClick="ImportSettingsFromClipboard">Import</MudButton>
         </MudTooltip>
      </MudStack>
   </div>
</MudCardContent>
@inherits ProjectOverviewDialogBase

@using IotZoo.Components

<MudDialog>
   <TitleContent>
      <MudText Typo="Typo.h6">Overview of Project '@Project.ProjectName'</MudText>
   </TitleContent>
   <DialogContent>
      <div style="position:relative; min-height:400px;">
      <HtmlRender Selector=".mermaid"
                  HtmlContent="@this.HtmlContent"
                  SecurityLevel="SecurityLevel.Loose" />
      <MudOverlay Visible="IsBusy" Absolute="true" DarkBackground="true">
         <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
      </MudOverlay>
      </div>
   </DialogContent>
   <DialogActions>
      <MudButton Class="MudButtonText"
                 OnClick="OkBtnPress">
         Ok
      </MudButton>
   </DialogActions>
</MudDialog>
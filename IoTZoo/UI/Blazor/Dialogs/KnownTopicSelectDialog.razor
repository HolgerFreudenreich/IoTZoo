@using Domain.Pocos

<MudDialog>
   <TitleContent>
      <MudText Typo="Typo.h6">Add Topic to Dashboard</MudText>
   </TitleContent>
   <DialogContent>
      <MudSelect T="KnownTopic"
                 @bind-Value="SelectedKnownTopic"
                 Label="Known Topic"
                 Variant="Variant.Text"
                 Margin="Margin.Normal"
                 ToStringFunc="@(t => t?.FullQualifiedTopic)">
         @foreach (var knownTopic in KnownTopics)
         {
            <MudSelectItem Value="@knownTopic">@knownTopic.FullQualifiedTopic</MudSelectItem>
         }
               </MudSelect>
               <MudSelect T="TopicDisplayType"
                    @bind-Value="SelectedDisplayType"
                    Label="Display Type"
                    Variant="Variant.Text"
                    Margin="Margin.Normal">
            @foreach (var displayType in Enum.GetValues<TopicDisplayType>())
            {
               <MudSelectItem Value="@displayType">@displayType</MudSelectItem>
            }
         </MudSelect>
      </DialogContent>
   <DialogActions>
      <MudButton OnClick="Cancel">Cancel</MudButton>
      <MudButton Variant="Variant.Filled"
                 StartIcon="@Icons.Material.Filled.Add"
                 Color="Color.Success"
                 Size="Size.Small"
                 Disabled="SelectedKnownTopic == null"
                 OnClick="Confirm">Add</MudButton>
   </DialogActions>
</MudDialog>

@code {
   [CascadingParameter]
   private IMudDialogInstance MudDialog { get; set; } = null!;

   [Parameter]
   public List<KnownTopic> KnownTopics { get; set; } = [];

   private KnownTopic? SelectedKnownTopic { get; set; }

   private TopicDisplayType SelectedDisplayType { get; set; } = TopicDisplayType.Text;

   private void Cancel() => MudDialog.Cancel();

   private void Confirm() => MudDialog.Close(DialogResult.Ok(new KnownTopicSelection(SelectedKnownTopic!, SelectedDisplayType)));

   public record KnownTopicSelection(KnownTopic KnownTopic, TopicDisplayType DisplayType);
}

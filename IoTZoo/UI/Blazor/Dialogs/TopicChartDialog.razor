@inherits TopicChartDialogBase

<MudDialog>
   <TitleContent>
      <MudText Typo="Typo.h6">@Topic</MudText>
   </TitleContent>
   <DialogContent>
      <MudStack Row="true">
         <MudStack>
            <MudDatePicker Label="Start date"
                           @bind-Date="StartDate"
                           Editable="true" />
            <MudTimePicker Label="Start time"
                           @bind-Time="StartTime" />
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => ShiftStart(TimeSpan.FromDays(-1)))">
               -1 Day
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => ShiftStart(TimeSpan.FromHours(-1)))">
               -1 Hour
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => ShiftStart(TimeSpan.FromMinutes(-1)))">
               -1 Minute
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(() => ShiftStart(TimeSpan.FromDays(1)))">
               +1 Day
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(() => ShiftStart(TimeSpan.FromHours(1)))">
               +1 Hour
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(() => ShiftStart(TimeSpan.FromMinutes(1)))">
               +1 Minute
            </MudButton>
         </MudStack>
         <MudStack>
            <MudDatePicker Label="End date"
                           @bind-Date="EndDate"
                           Editable="true" />
            <MudTimePicker Label="End time"
                           @bind-Time="EndTime" />
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => ShiftEnd(TimeSpan.FromDays(-1)))">
               -1 Day
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => ShiftEnd(TimeSpan.FromHours(-1)))">
               -1 Hour
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => ShiftEnd(TimeSpan.FromMinutes(-1)))">
               -1 Minute
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(() => ShiftEnd(TimeSpan.FromDays(1)))">
               +1 Day
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(() => ShiftEnd(TimeSpan.FromHours(1)))">
               +1 Hour
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(() => ShiftEnd(TimeSpan.FromMinutes(1)))">
               +1 Minute
            </MudButton>
         </MudStack>
      </MudStack>
      @if (Series.Count > 0)
      {
         <MudChart ChartType="ChartType.Line"
                   ChartSeries="@Series"
                   ChartLabels="@XAxisLabels"
                   MatchBoundsToSize="true"
                   Width="100%"
                   Height="400px" />
      }
      else
      {
         <MudText>No numeric values available for this topic.</MudText>
      }
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="Close">
         Ok
      </MudButton>
   </DialogActions>
</MudDialog>

<br />
<MudPaper Style="padding: 2px 10px 2px 10px; height: 230px;">
  <MudStack Row="true">
    <MudTextField @bind-Value="TopicEntry.Topic"
                  Label="Topic"
                  Immediate="true"
                  Variant="Variant.Text">
    </MudTextField>
  </MudStack>

  <MudTextField @bind-Value="TopicEntry.Payload"
                Label="Payload"
                Immediate="true"
                Variant="Variant.Text">
  </MudTextField>
   <MudSwitch @bind-Value="TopicEntry.Retain" Label="Retain Message" />
     <br />
     <br />
     <MudStack Row="true">
       <MudButton OnClick="PublishAsync"
                  Variant="Variant.Filled"
                  EndIcon="@Icons.Material.Filled.Send"
                  Color="Color.Primary">
         Publish
       </MudButton>
       <MudButton OnClick="ExportToClipboardAsync"
                  Variant="Variant.Outlined"
                  EndIcon="@Icons.Material.Filled.ContentCopy"
                  Color="Color.Default">
         Export
       </MudButton>
       <MudButton OnClick="ImportFromClipboardAsync"
                  Variant="Variant.Outlined"
                  EndIcon="@Icons.Material.Filled.ContentPaste"
                  Color="Color.Default">
         Import
       </MudButton>
     </MudStack>
  </MudPaper>
<br />
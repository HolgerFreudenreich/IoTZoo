@inherits LcdDisplayBase

<svg xmlns="http://www.w3.org/2000/svg" viewBox="@ViewBox" width="@VisibleWidth" height="372"
     preserveAspectRatio="@AspectRatio" role="img" aria-label="@($"LCD2004 display: {Value}")" style="@DisplayStyle">
   <rect x="3" y="3" width="631" height="366" rx="8" fill="#167a50" stroke="#0d5439" stroke-width="3" />
   <g fill="#d5d9db" stroke="#a9b0b4" stroke-width="2">
      <circle cx="22" cy="22" r="11" /><circle cx="615" cy="22" r="11" />
      <circle cx="22" cy="350" r="11" /><circle cx="615" cy="350" r="11" />
   </g>
   <g fill="#294139">
      <circle cx="22" cy="22" r="5" /><circle cx="615" cy="22" r="5" />
      <circle cx="22" cy="350" r="5" /><circle cx="615" cy="350" r="5" />
   </g>
   <rect x="35" y="43" width="564" height="285" rx="3" fill="#292d30" stroke="#b5b8b2" stroke-width="5" />
   <rect x="49" y="57" width="536" height="257" fill="#164cba" />
   @for (int row = 0; row < RowCount; row++)
   {
      @for (int column = 0; column < ColumnCount; column++)
      {
         <rect x="@(57 + column * 26)" y="@(66 + row * 61)" width="23" height="51" fill="#1c57bd" />
         @if (column < Lines[row].Length)
         {
            <g><text class="lcd2004-character" x="@(68 + column * 26)" y="@(106 + row * 61)" xml:space="preserve"
                     fill="#e2f5ff" font-family="monospace" font-size="36" text-anchor="middle">@Lines[row][column]</text></g>
         }
      }
   }
   <text x="317" y="352" fill="#e6f4e9" font-family="sans-serif" font-size="14" text-anchor="middle">@(Label ?? "LCD2004")</text>
   @if (ShowConnections)
   {
      <g class="lcd2004-connections">
         <rect x="602" y="126" width="30" height="120" rx="3" fill="#173a2d" stroke="#b6c8b7" stroke-width="2" />
         @for (int pin = 0; pin < PinLabels.Length; pin++)
         {
            <g><text x="597" y="@(148 + pin * 28)" fill="#e6f4e9" font-family="sans-serif" font-size="10" text-anchor="end">@PinLabels[pin]</text></g>
            <rect x="606" y="@(134 + pin * 28)" width="24" height="20" rx="3" fill="#15191c" />
            <rect x="620" y="@(140 + pin * 28)" width="81" height="8" rx="2" fill="#c6cbd0" />
         }
      </g>
   }
</svg>

@using Domain.Pocos
@using Radzen.Blazor

<MudStack Row="true">
   <div title="@Topic" style="width:300px;">
       <MudText Typo="Typo.body1" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@DisplayName</MudText>
   </div>
   <div title="@Message" style="width:600px;">
       @switch (DisplayType)
       {
               case TopicDisplayType.Text:
                   <MudText Typo="Typo.body1" Style="@($"overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:{FontSize}px; {TextStyle}")">@Message</MudText>
                   break;
               case TopicDisplayType.Json:
                   <JsonTreeView Json="@Message" ExpandLevels="1" />
                   break;
               case TopicDisplayType.Tm1637_4:
                   @if (Message.Length == 0 && DateOfReceipt == null)
                   {
                       <MudText Typo="Typo.body1">Waiting for a message</MudText>
                   }
                   else if (!TM1637_4Display.IsValidValue(Message))
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display message on TM1637: expected a number of up to four digits (including the minus sign) or a time in HH:mm format.</MudText>
                   }
                   else if (GaugeSettings.Height <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display TM1637: height must be greater than zero.</MudText>
                   }
                   else if (GaugeSettings.Width is <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display TM1637: width must be greater than zero.</MudText>
                   }
                   else if (!TM1637DisplayBase.IsValidSegmentColor(GaugeSettings.SegmentColor))
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display TM1637: segment color must be in #RRGGBB format.</MudText>
                   }
                   else
                   {
                       <TM1637_4Display Value="@Message" Height="@GaugeSettings.Height" Width="@GaugeSettings.Width" LeadingZeros="@GaugeSettings.LeadingZeros" ShowConnections="@GaugeSettings.ShowConnections" Label="@GaugeSettings.DisplayLabel" SegmentColor="@GaugeSettings.SegmentColor" />
                   }
                   break;
               case TopicDisplayType.Tm1637_6:
                   @if (Message.Length == 0 && DateOfReceipt == null)
                   {
                       <MudText Typo="Typo.body1">Waiting for a message</MudText>
                   }
                   else if (!TM1637_6Display.IsValidValue(Message))
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display message on TM1637: expected a number of up to six characters (including the minus sign) or a time in HH:mm or HH:mm:ss format.</MudText>
                   }
                   else if (GaugeSettings.Height <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display TM1637: height must be greater than zero.</MudText>
                   }
                   else if (GaugeSettings.Width is <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display TM1637: width must be greater than zero.</MudText>
                   }
                   else if (!TM1637DisplayBase.IsValidSegmentColor(GaugeSettings.SegmentColor))
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display TM1637: segment color must be in #RRGGBB format.</MudText>
                   }
                   else
                   {
                       <TM1637_6Display Value="@Message" Height="@GaugeSettings.Height" Width="@GaugeSettings.Width" LeadingZeros="@GaugeSettings.LeadingZeros" ShowConnections="@GaugeSettings.ShowConnections" Label="@GaugeSettings.DisplayLabel" SegmentColor="@GaugeSettings.SegmentColor" />
                   }
                   break;
               case TopicDisplayType.Lcd1602:
                   @if (Message.Length == 0 && DateOfReceipt == null)
                   {
                       <MudText Typo="Typo.body1">Waiting for a message</MudText>
                   }
                   else if (!Lcd1602Display.IsValidValue(Message))
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display message on LCD1602: expected up to two lines of 16 printable characters.</MudText>
                   }
                   else if (GaugeSettings.Height <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display LCD1602: height must be greater than zero.</MudText>
                   }
                   else if (GaugeSettings.Width is <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display LCD1602: width must be greater than zero.</MudText>
                   }
                   else
                   {
                       <Lcd1602Display Value="@Message" Height="@GaugeSettings.Height" Width="@GaugeSettings.Width" ShowConnections="@GaugeSettings.ShowConnections" Label="@GaugeSettings.DisplayLabel" />
                   }
                   break;
               case TopicDisplayType.Lcd1604:
                   @if (Message.Length == 0 && DateOfReceipt == null)
                   {
                       <MudText Typo="Typo.body1">Waiting for a message</MudText>
                   }
                   else if (!Lcd1604Display.IsValidValue(Message))
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display message on LCD1604: expected up to four lines of 16 printable characters.</MudText>
                   }
                   else if (GaugeSettings.Height <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display LCD1604: height must be greater than zero.</MudText>
                   }
                   else if (GaugeSettings.Width is <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display LCD1604: width must be greater than zero.</MudText>
                   }
                   else
                   {
                       <Lcd1604Display Value="@Message" Height="@GaugeSettings.Height" Width="@GaugeSettings.Width" ShowConnections="@GaugeSettings.ShowConnections" Label="@GaugeSettings.DisplayLabel" />
                   }
                   break;
               case TopicDisplayType.Lcd2004:
                   @if (Message.Length == 0 && DateOfReceipt == null)
                   {
                       <MudText Typo="Typo.body1">Waiting for a message</MudText>
                   }
                   else if (!Lcd2004Display.IsValidValue(Message))
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display message on LCD2004: expected up to four lines of 20 printable characters.</MudText>
                   }
                   else if (GaugeSettings.Height <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display LCD2004: height must be greater than zero.</MudText>
                   }
                   else if (GaugeSettings.Width is <= 0)
                   {
                       <MudText Typo="Typo.body1" Color="Color.Error">Cannot display LCD2004: width must be greater than zero.</MudText>
                   }
                   else
                   {
                       <Lcd2004Display Value="@Message" Height="@GaugeSettings.Height" Width="@GaugeSettings.Width" ShowConnections="@GaugeSettings.ShowConnections" Label="@GaugeSettings.DisplayLabel" />
                   }
                   break;
               case TopicDisplayType.Gauge:
                   <div style="width:100%; display:flex; flex-direction:column; align-items:center;">
                       @switch (GaugeSettings.GaugeType)
                       {
                           case GaugeType.Linear:
                               <RadzenLinearGauge Style="@GaugeStyle">
                                   <RadzenLinearGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep" Orientation="@RadzenOrientation" ShowTickLabels="@GaugeSettings.ShowTickLabels">
                                       @foreach (var range in GaugeSettings.Ranges)
                                       {
                                           <RadzenLinearGaugeScaleRange From="@range.From" To="@range.To" Fill="@range.Color" />
                                       }
                                       <RadzenLinearGaugeScalePointer Value="@GaugeValue" />
                                   </RadzenLinearGaugeScale>
                               </RadzenLinearGauge>
                               break;
                           case GaugeType.Radial:
                               <RadzenRadialGauge Style="@GaugeStyle">
                                   <RadzenRadialGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep" StartAngle="@GaugeSettings.StartAngle" EndAngle="@GaugeSettings.EndAngle" ShowTickLabels="@GaugeSettings.ShowTickLabels">
                                       @foreach (var range in GaugeSettings.Ranges)
                                       {
                                           <RadzenRadialGaugeScaleRange From="@range.From" To="@range.To" Fill="@range.Color" />
                                       }
                                       <RadzenRadialGaugeScalePointer Value="@GaugeValue" />
                                   </RadzenRadialGaugeScale>
                               </RadzenRadialGauge>
                               break;
                           default:
                               <RadzenArcGauge Style="@GaugeStyle">
                                   <RadzenArcGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep">
                                       <RadzenArcGaugeScaleValue Value="@GaugeValue" Fill="@GaugeSettings.ArcColor" />
                                   </RadzenArcGaugeScale>
                               </RadzenArcGauge>
                               break;
                       }
                       <MudText Typo="Typo.caption" Align="Align.Center" Style="@($"font-size:{FontSize}px; {LabelStyle}")">@GaugeSettings.Label @GaugeSettings.Unit</MudText>
                   </div>
                   break;
           }
   </div>
   <div style="width:200px; white-space:nowrap;">
       @(DateOfReceipt?.ToLocalTime().ToString($"{DateTimeFormat}.fff"))
   </div>
   <div style="width:96px; height:35px; ">
       <MudIconButton Size="Size.Small"
                      Icon="@Icons.Material.Filled.ShowChart"
                      OnClick="ShowChart" />
       <MudIconButton Icon="@Icons.Material.Filled.Edit"
                      Size="Size.Small"
                      OnClick="EditTopic" />
       <MudIconButton Icon="@Icons.Material.Filled.Delete"
                      Size="Size.Small"
                      OnClick="() => OnDelete.InvokeAsync(Topic)" />
   </div>
</MudStack>

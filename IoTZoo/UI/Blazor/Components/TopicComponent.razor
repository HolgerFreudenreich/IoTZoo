@using Domain.Pocos
@using Radzen.Blazor

<MudStack Row="true">
   <div title="@Topic" style="width:300px;">
       <MudText Typo="Typo.body1" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@DisplayName</MudText>
   </div>
   <div title="@Message" style="width:600px;">
       @switch (DisplayType)
       {
               case TopicDisplayType.Text:
                   <MudText Typo="Typo.body1" Style="@($"overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:{FontSize}px; {TextStyle}")">@Message</MudText>
                   break;
               case TopicDisplayType.Gauge:
                   <div style="width:100%; display:flex; flex-direction:column; align-items:center;">
                       @switch (GaugeSettings.GaugeType)
                       {
                           case GaugeType.Linear:
                               <RadzenLinearGauge Style="@GaugeStyle">
                                   <RadzenLinearGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep" Orientation="@RadzenOrientation" ShowTickLabels="@GaugeSettings.ShowTickLabels">
                                       @foreach (var range in GaugeSettings.Ranges)
                                       {
                                           <RadzenLinearGaugeScaleRange From="@range.From" To="@range.To" Fill="@range.Color" />
                                       }
                                       <RadzenLinearGaugeScalePointer Value="@GaugeValue" />
                                   </RadzenLinearGaugeScale>
                               </RadzenLinearGauge>
                               break;
                           case GaugeType.Radial:
                               <RadzenRadialGauge Style="@GaugeStyle">
                                   <RadzenRadialGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep" StartAngle="@GaugeSettings.StartAngle" EndAngle="@GaugeSettings.EndAngle" ShowTickLabels="@GaugeSettings.ShowTickLabels">
                                       @foreach (var range in GaugeSettings.Ranges)
                                       {
                                           <RadzenRadialGaugeScaleRange From="@range.From" To="@range.To" Fill="@range.Color" />
                                       }
                                       <RadzenRadialGaugeScalePointer Value="@GaugeValue" />
                                   </RadzenRadialGaugeScale>
                               </RadzenRadialGauge>
                               break;
                           default:
                               <RadzenArcGauge Style="@GaugeStyle">
                                   <RadzenArcGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep">
                                       <RadzenArcGaugeScaleValue Value="@GaugeValue" Fill="@GaugeSettings.ArcColor" />
                                   </RadzenArcGaugeScale>
                               </RadzenArcGauge>
                               break;
                       }
                       <MudText Typo="Typo.caption" Align="Align.Center" Style="@($"font-size:{FontSize}px; {LabelStyle}")">@GaugeSettings.Label @GaugeSettings.Unit</MudText>
                   </div>
                   break;
           }
   </div>
   <div style="width:200px; white-space:nowrap;">
       @(DateOfReceipt?.ToLocalTime().ToString($"{DateTimeFormat}.fff"))
   </div>
   <div style="width:96px; height:35px; ">
       <MudIconButton Size="Size.Small"
                      Icon="@Icons.Material.Filled.ShowChart"
                      OnClick="ShowChart" />
       <MudIconButton Icon="@Icons.Material.Filled.Edit"
                      Size="Size.Small"
                      OnClick="EditTopic" />
       <MudIconButton Icon="@Icons.Material.Filled.Delete"
                      Size="Size.Small"
                      OnClick="() => OnDelete.InvokeAsync(Topic)" />
   </div>
</MudStack>

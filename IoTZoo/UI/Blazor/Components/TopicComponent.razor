@using Domain.Interfaces
@using Domain.Interfaces.Crud
@using Domain.Pocos
@using IotZoo.Components
@using IotZoo.Dialogs
@using System.Globalization
@using Radzen.Blazor
<MudStack Row="true">
   <div title="@Topic" style="width:300px;">
       <MudText Typo="Typo.body1" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@DisplayName</MudText>
   </div>
   <div title="@Message" style="width:300px;">
       @switch (DisplayType)
       {
               case TopicDisplayType.Text:
                   <MudText Typo="Typo.body1" Style="@($"overflow:hidden; text-overflow:ellipsis; white-space:nowrap; {TextStyle}")">@Message</MudText>
                   break;
               case TopicDisplayType.Gauge:
                   <div style="width:100%; display:flex; flex-direction:column; align-items:center;">
                       @switch (GaugeSettings.GaugeType)
                       {
                           case GaugeType.Linear:
                               <RadzenLinearGauge Style="@GaugeStyle">
                                   <RadzenLinearGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep" Orientation="@RadzenOrientation" ShowTickLabels="@GaugeSettings.ShowTickLabels">
                                       @foreach (var range in GaugeSettings.Ranges)
                                       {
                                           <RadzenLinearGaugeScaleRange From="@range.From" To="@range.To" Fill="@range.Color" />
                                       }
                                       <RadzenLinearGaugeScalePointer Value="@GaugeValue" />
                                   </RadzenLinearGaugeScale>
                               </RadzenLinearGauge>
                               break;
                           case GaugeType.Radial:
                               <RadzenRadialGauge Style="@GaugeStyle">
                                   <RadzenRadialGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep" StartAngle="@GaugeSettings.StartAngle" EndAngle="@GaugeSettings.EndAngle" ShowTickLabels="@GaugeSettings.ShowTickLabels">
                                       @foreach (var range in GaugeSettings.Ranges)
                                       {
                                           <RadzenRadialGaugeScaleRange From="@range.From" To="@range.To" Fill="@range.Color" />
                                       }
                                       <RadzenRadialGaugeScalePointer Value="@GaugeValue" />
                                   </RadzenRadialGaugeScale>
                               </RadzenRadialGauge>
                               break;
                           default:
                               <RadzenArcGauge Style="@GaugeStyle">
                                   <RadzenArcGaugeScale Min="@GaugeSettings.Min" Max="@GaugeSettings.Max" Step="@GaugeStep">
                                       <RadzenArcGaugeScaleValue Value="@GaugeValue" Fill="@GaugeSettings.ArcColor" />
                                   </RadzenArcGaugeScale>
                               </RadzenArcGauge>
                               break;
                       }
                       <MudText Typo="Typo.caption" Align="Align.Center" Style="@LabelStyle">@GaugeSettings.Label @GaugeSettings.Unit</MudText>
                   </div>
                   break;
           }
   </div>
   <div style="width:200px; white-space:nowrap;">
       @(DateOfReceipt?.ToLocalTime().ToString($"{DateTimeFormat}.fff"))
   </div>
   <div style="width:96px; height:35px; ">
       <MudIconButton Size="Size.Small"
                      Icon="@Icons.Material.Filled.ShowChart"
                      OnClick="ShowChart" />
       <MudIconButton Icon="@Icons.Material.Filled.Edit"
                      Size="Size.Small"
                      OnClick="EditTopic" />
       <MudIconButton Icon="@Icons.Material.Filled.Delete"
                      Size="Size.Small"
                      OnClick="() => OnDelete.InvokeAsync(Topic)" />
   </div>
</MudStack>

@code {
   [Inject]
   public IDialogService DialogService { get; set; } = null!;

   [Inject]
   public IDataTransferService DataTransferService { get; set; } = null!;

   [Inject]
   public ITopicHistoryCrudService TopicHistoryService { get; set; } = null!;

   [Inject]
   public IKnownTopicsCrudService KnownTopicsService { get; set; } = null!;

   [Parameter]
   public string Topic { get; set; } = string.Empty;

   [Parameter]
   public string? FriendlyName { get; set; }

   [Parameter]
   public string Message { get; set; } = string.Empty;

   [Parameter]
   public TopicDisplayType DisplayType { get; set; } = TopicDisplayType.Text;

   [Parameter]
   public GaugeSettings GaugeSettings { get; set; } = new();

   [Parameter]
   public DateTime? DateOfReceipt { get; set; }

   [Parameter]
   public string DateTimeFormat { get; set; } = string.Empty;

   [Parameter]
   public Project? Project { get; set; }

   [Parameter]
   public EventCallback<string> OnDelete { get; set; }

   [Parameter]
   public EventCallback OnEdit { get; set; }

   private string GaugeStyle => $"width:calc(100% - 24px); height:{GaugeSettings.Height}px; font-size:10px;";

   private double GaugeValue => double.TryParse(Message, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) ? value : 0;

   private double GaugeStep => (GaugeSettings.Max - GaugeSettings.Min) / 4;

   private string LabelStyle => GaugeSettings.GaugeType == GaugeType.Arc ? "margin-top:-80px;" : string.Empty;

   private string TextStyle => double.TryParse(Message, NumberStyles.Float, CultureInfo.InvariantCulture, out var value) && GaugeSettings.Ranges.FirstOrDefault(r => value >= r.From && value <= r.To) is { } range ? $"color:{range.Color};" : string.Empty;

   private Radzen.Orientation RadzenOrientation => GaugeSettings.Orientation == GaugeOrientation.Vertical ? Radzen.Orientation.Vertical : Radzen.Orientation.Horizontal;

   private string RelativeTopic
   {
      get
      {
         var prefix = $"{DataTransferService.NamespaceName}/{Project?.ProjectName}/";
         return Topic.StartsWith(prefix, StringComparison.Ordinal) ? Topic[prefix.Length..] : Topic;
      }
   }

   private string DisplayName => string.IsNullOrWhiteSpace(FriendlyName) ? RelativeTopic : FriendlyName;

   private async Task EditTopic()
   {
      var knownTopic = await KnownTopicsService.GetKnownTopicByTopicName(Project?.ProjectName ?? string.Empty, RelativeTopic);
      if (knownTopic == null)
      {
         return;
      }
      var parameters = new DialogParameters { [nameof(KnownTopicEditorBase.KnownTopic)] = knownTopic };
      var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
      var dialog = await DialogService.ShowAsync<KnownTopicEditor>("Edit Known Topic", parameters, options);
      var result = await dialog.Result;
      if (result?.Canceled == false)
      {
         await OnEdit.InvokeAsync();
      }
   }

   private async Task ShowChart()
   {
      var history = await TopicHistoryService.LoadTopicHistory(Project);
      var entries = history.Where(x => x.Topic == RelativeTopic).ToList();
      var parameters = new DialogParameters
           {
               { nameof(TopicChartDialogBase.Topic), Topic },
               { nameof(TopicChartDialogBase.Entries), entries }
           };
      var options = new DialogOptions { MaxWidth = MaxWidth.False, FullWidth = true };
      await DialogService.ShowAsync<TopicChartDialog>(Topic, parameters, options);
   }
}
